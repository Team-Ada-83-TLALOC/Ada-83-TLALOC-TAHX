# Rebudgete (rebudgeter.py, chemins_dc2.txt) : periode 26.0 ns, atteignable 26.00 ; g = 0.550 pour cette macro.
# -max : instants alloues par la STA d'assemblage (meme instant pour la sortie d'une
# macro et l'entree qu'elle attaque), biais 0.3 ns ; -min : ancien SDC (hold).
# Repere : broche d'horloge de la macro ; l'insertion interne (1.01 ns) est vue
# par le flux en horloge propagee. Valeur d'un bus : son pire bit, puis les bits qui s'en
# ecartent. Traversees : set_max_delay par paire de bus. Ne pas modifier a la main.
set clk_port [get_ports clk_i]
create_clock -name clk -period 26 $clk_port
set_clock_uncertainty -setup 0.5 [get_clocks clk]
set_clock_uncertainty -hold  0.1 [get_clocks clk]
set_driving_cell -lib_cell sg13cmos5l_buf_4 -pin X [all_inputs -no_clocks]
set_load 0.02 [all_outputs]
set_input_delay -max  12.212 -clock clk [get_ports {arith_complete_fault_i.code[*]}]   ;# avant 4.997
set_input_delay -min 4.997 -clock clk [get_ports {arith_complete_fault_i.code[*]}]
set_input_delay -max   7.330 -clock clk [get_ports {arith_complete_fault_i.code[1]}]
