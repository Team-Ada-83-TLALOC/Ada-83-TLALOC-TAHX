# ino_execute (instance u_core.u_backend de TAHX_1) : budgets d'entree / sortie a 25 ns,
# coin slow, modele de fil 'Zero', tires du coeur entier par synth_InO/sta/sdc_macro.tcl.
# Par bus : le pire bit. Retards exterieurs estimes, pas une signature.
# Insertion d'horloge exterieure supposee : 0.8 ns (entrees + 0.8, sorties - 0.8).
set clk_port [get_ports clk_i]
create_clock -name clk -period 25 $clk_port
set_clock_uncertainty -setup 0.5 [get_clocks clk]
set_clock_uncertainty -hold  0.1 [get_clocks clk]
set_driving_cell -lib_cell sg13cmos5l_buf_4 -pin X [all_inputs -no_clocks]
set_load 0.02 [all_outputs]
set_input_delay   1.153 -clock clk [get_ports {frame_dsp_i[*]}]
set_input_delay   1.259 -clock clk [get_ports {frame_rsp_i[*]}]
set_input_delay   4.222 -clock clk [get_ports {issue_i.address[*]}]
set_input_delay   3.350 -clock clk [get_ports {issue_i.address_known}]
set_input_delay   3.289 -clock clk [get_ports {issue_i.address_ofs}]
set_input_delay   2.817 -clock clk [get_ports {issue_i.issue_class[*]}]
set_input_delay   3.266 -clock clk [get_ports {issue_i.operand[*]}]
set_input_delay   2.742 -clock clk [get_ports {issue_i.operand_count[*]}]
set_input_delay   3.411 -clock clk [get_ports {issue_i.slot[*]}]
set_input_delay   4.088 -clock clk [get_ports {issue_valid_i}]
set_input_delay   7.458 -clock clk [get_ports {limits_i.lim_csp[*]}]
set_input_delay   1.071 -clock clk [get_ports {limits_i.lim_hp[*]}]
set_input_delay   1.899 -clock clk [get_ports {mem_rsp_i.fault}]
set_input_delay  10.804 -clock clk [get_ports {mem_rsp_i.rdata[*]}]
set_input_delay   8.474 -clock clk [get_ports {mem_rsp_i.valid}]
set_input_delay   1.069 -clock clk [get_ports {stack_maint_done_i}]
set_input_delay   1.049 -clock clk [get_ports {sync_copile_i.cfp[*]}]
set_input_delay   1.054 -clock clk [get_ports {sync_copile_i.csp[*]}]
set_input_delay   1.055 -clock clk [get_ports {sync_copile_i.hp[*]}]
set_input_delay   1.055 -clock clk [get_ports {sync_copile_i.hp_valid}]
set_input_delay   2.453 -clock clk [get_ports {sync_valid_i}]
set_output_delay  4.182 -clock clk [get_ports {complete_o.fault[*]}]
set_output_delay  3.888 -clock clk [get_ports {complete_o.result[*]}]
set_output_delay  3.991 -clock clk [get_ports {complete_o.taken}]
set_output_delay  4.795 -clock clk [get_ports {complete_o.target[*]}]
set_output_delay  4.019 -clock clk [get_ports {complete_o.valid}]
set_output_delay  0.081 -clock clk [get_ports {copile_o.cfp[*]}]
set_output_delay  0.120 -clock clk [get_ports {copile_o.csp[*]}]
set_output_delay  0.080 -clock clk [get_ports {copile_o.hp[*]}]
set_output_delay 10.665 -clock clk [get_ports {disp_sel_o[*]}]
set_output_delay  5.504 -clock clk [get_ports {issue_ready_o}]
set_output_delay  2.335 -clock clk [get_ports {mem_req_o.address[*]}]
set_output_delay  1.428 -clock clk [get_ports {mem_req_o.outside}]
set_output_delay  1.265 -clock clk [get_ports {mem_req_o.probe}]
set_output_delay  2.223 -clock clk [get_ports {mem_req_o.size[*]}]
set_output_delay  5.504 -clock clk [get_ports {mem_req_o.valid}]
set_output_delay  0.256 -clock clk [get_ports {mem_req_o.wdata[*]}]
set_output_delay  0.248 -clock clk [get_ports {mem_req_o.write}]
set_output_delay  0.257 -clock clk [get_ports {stack_maint_o.base[*]}]
set_output_delay  0.250 -clock clk [get_ports {stack_maint_o.kind[*]}]
set_output_delay  0.214 -clock clk [get_ports {stack_maint_o.length[*]}]
set_output_delay  3.695 -clock clk [get_ports {stack_maint_o.valid}]
