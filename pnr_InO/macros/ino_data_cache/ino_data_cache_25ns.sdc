# Rebudgete (rebudgeter.py, chemins_dc2.txt) : periode 26.0 ns, atteignable 26.00 ; g = 0.725 pour cette macro.
# -max : instants alloues par la STA d'assemblage (meme instant pour la sortie d'une
# macro et l'entree qu'elle attaque), biais 0.3 ns ; -min : ancien SDC (hold).
# Repere : broche d'horloge de la macro ; l'insertion interne (2.22 ns) est vue
# par le flux en horloge propagee. Valeur d'un bus : son pire bit, puis les bits qui s'en
# ecartent. Traversees : set_max_delay par paire de bus. Ne pas modifier a la main.
set clk_port [get_ports clk_i]
create_clock -name clk -period 26 $clk_port
set_clock_uncertainty -setup 0.5 [get_clocks clk]
set_clock_uncertainty -hold  0.1 [get_clocks clk]
set_driving_cell -lib_cell sg13cmos5l_buf_4 -pin X [all_inputs -no_clocks]
set_load 0.02 [all_outputs]
set_input_delay -max  11.674 -clock clk [get_ports {d_fault_i}]   ;# avant 8.300
set_input_delay -min 8.300 -clock clk [get_ports {d_fault_i}]
set_input_delay -max  11.824 -clock clk [get_ports {d_rdata_i[*]}]   ;# avant 8.300
set_input_delay -min 8.300 -clock clk [get_ports {d_rdata_i[*]}]
set_input_delay -max  11.825 -clock clk [get_ports {d_ready_i}]   ;# avant 8.300
set_input_delay -min 8.300 -clock clk [get_ports {d_ready_i}]
set_input_delay -max  11.824 -clock clk [get_ports {d_rvalid_i}]   ;# avant 8.300
set_input_delay -min 8.300 -clock clk [get_ports {d_rvalid_i}]
set_input_delay -max  23.479 -clock clk [get_ports {exec_req_i.address[*]}]   ;# avant 14.176
