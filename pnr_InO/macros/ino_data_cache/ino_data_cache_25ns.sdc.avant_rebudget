# ino_data_cache (instance u_data_cache de TAHX_1) : budgets d'entree / sortie a 25 ns,
# coin slow, modele de fil 'Zero', tires du coeur entier par synth_InO/sta/sdc_macro.tcl.
# Par bus : le pire bit. Retards exterieurs estimes, pas une signature.
# Insertion d'horloge exterieure supposee : 0.8 ns (entrees + 0.8, sorties - 0.8).
set clk_port [get_ports clk_i]
create_clock -name clk -period 25 $clk_port
set_clock_uncertainty -setup 0.5 [get_clocks clk]
set_clock_uncertainty -hold  0.1 [get_clocks clk]
set_driving_cell -lib_cell sg13cmos5l_buf_4 -pin X [all_inputs -no_clocks]
set_load 0.02 [all_outputs]
set_input_delay   8.300 -clock clk [get_ports {d_fault_i}]
set_input_delay   8.300 -clock clk [get_ports {d_rdata_i[*]}]
set_input_delay   8.300 -clock clk [get_ports {d_ready_i}]
set_input_delay   8.300 -clock clk [get_ports {d_rvalid_i}]
set_input_delay  14.176 -clock clk [get_ports {exec_req_i.address[*]}]
set_input_delay  15.836 -clock clk [get_ports {exec_req_i.outside}]
set_input_delay   5.338 -clock clk [get_ports {exec_req_i.probe}]
set_input_delay  13.891 -clock clk [get_ports {exec_req_i.size[*]}]
set_input_delay  13.633 -clock clk [get_ports {exec_req_i.valid}]
set_input_delay  14.064 -clock clk [get_ports {exec_req_i.wdata[*]}]
set_input_delay  14.075 -clock clk [get_ports {exec_req_i.write}]
set_input_delay   2.946 -clock clk [get_ports {stack_req_i.address[*]}]
set_input_delay   2.733 -clock clk [get_ports {stack_req_i.size[*]}]
set_input_delay   2.733 -clock clk [get_ports {stack_req_i.valid}]
set_input_delay   2.626 -clock clk [get_ports {stack_req_i.wdata[*]}]
set_input_delay   2.590 -clock clk [get_ports {stack_req_i.write}]
set_output_delay  7.200 -clock clk [get_ports {d_addr_o[*]}]
set_output_delay  7.200 -clock clk [get_ports {d_req_o}]
set_output_delay  7.200 -clock clk [get_ports {d_wdata_o[*]}]
set_output_delay  7.200 -clock clk [get_ports {d_write_o}]
set_output_delay  4.686 -clock clk [get_ports {exec_ready_o}]
set_output_delay  5.988 -clock clk [get_ports {exec_rsp_o.fault}]
set_output_delay  5.805 -clock clk [get_ports {exec_rsp_o.rdata[*]}]
set_output_delay  6.181 -clock clk [get_ports {exec_rsp_o.valid}]
set_output_delay  1.277 -clock clk [get_ports {stack_ready_o}]
set_output_delay  2.321 -clock clk [get_ports {stack_rsp_o.fault}]
set_output_delay  2.889 -clock clk [get_ports {stack_rsp_o.rdata[*]}]
set_output_delay  2.172 -clock clk [get_ports {stack_rsp_o.valid}]
