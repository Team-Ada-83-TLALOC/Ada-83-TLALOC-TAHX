# ino_exec_entier (instance u_core.u_backend.u_entier de TAHX_1) : budgets d'entree / sortie a 25 ns,
# coin slow, modele de fil 'Zero', tires du coeur entier par synth_InO/sta/sdc_macro.tcl.
# Par bus : le pire bit. Retards exterieurs estimes, pas une signature.
# Insertion d'horloge exterieure supposee : 0.8 ns (entrees + 0.8, sorties - 0.8).
set clk_port [get_ports clk_i]
create_clock -name clk -period 25 $clk_port
set_clock_uncertainty -setup 0.5 [get_clocks clk]
set_clock_uncertainty -hold  0.1 [get_clocks clk]
set_driving_cell -lib_cell sg13cmos5l_buf_4 -pin X [all_inputs -no_clocks]
set_load 0.02 [all_outputs]
set_input_delay   4.997 -clock clk [get_ports {arith_complete_fault_i.code[*]}]
set_input_delay   4.997 -clock clk [get_ports {arith_complete_fault_i.valid}]
set_input_delay   6.418 -clock clk [get_ports {arith_complete_result_i[*]}]
set_input_delay   2.917 -clock clk [get_ports {arith_complete_valid_i}]
set_input_delay   2.668 -clock clk [get_ports {arith_ready_i[*]}]
set_input_delay   1.152 -clock clk [get_ports {frame_dsp_i[*]}]
set_input_delay   1.262 -clock clk [get_ports {frame_rsp_i[*]}]
set_input_delay   4.235 -clock clk [get_ports {issue_i.address[*]}]
set_input_delay   3.464 -clock clk [get_ports {issue_i.address_known}]
set_input_delay   3.222 -clock clk [get_ports {issue_i.address_ofs}]
set_input_delay   2.897 -clock clk [get_ports {issue_i.issue_class[*]}]
set_input_delay   3.133 -clock clk [get_ports {issue_i.operand[*]}]
set_input_delay   2.809 -clock clk [get_ports {issue_i.operand_count[*]}]
set_input_delay   3.418 -clock clk [get_ports {issue_i.slot[*]}]
set_input_delay   4.082 -clock clk [get_ports {issue_valid_i}]
set_input_delay   8.068 -clock clk [get_ports {limits_i.lim_csp[*]}]
set_input_delay   1.084 -clock clk [get_ports {limits_i.lim_hp[*]}]
set_input_delay   1.924 -clock clk [get_ports {mem_rsp_i.fault}]
set_input_delay  10.867 -clock clk [get_ports {mem_rsp_i.rdata[*]}]
set_input_delay   8.303 -clock clk [get_ports {mem_rsp_i.valid}]
set_input_delay   1.097 -clock clk [get_ports {stack_maint_done_i}]
set_input_delay   1.049 -clock clk [get_ports {sync_copile_i.cfp[*]}]
set_input_delay   1.054 -clock clk [get_ports {sync_copile_i.csp[*]}]
set_input_delay   1.055 -clock clk [get_ports {sync_copile_i.hp[*]}]
set_input_delay   1.100 -clock clk [get_ports {sync_copile_i.hp_valid}]
set_input_delay   2.160 -clock clk [get_ports {sync_valid_i}]
set_output_delay  3.335 -clock clk [get_ports {complete_o.fault[*]}]
set_output_delay  4.056 -clock clk [get_ports {complete_o.result[*]}]
set_output_delay  3.919 -clock clk [get_ports {complete_o.taken}]
set_output_delay  4.723 -clock clk [get_ports {complete_o.target[*]}]
set_output_delay  3.917 -clock clk [get_ports {complete_o.valid}]
set_output_delay  0.080 -clock clk [get_ports {copile_o.cfp[*]}]
set_output_delay  0.120 -clock clk [get_ports {copile_o.csp[*]}]
set_output_delay  0.081 -clock clk [get_ports {copile_o.hp[*]}]
set_output_delay 11.125 -clock clk [get_ports {disp_sel_o[*]}]
set_output_delay  5.479 -clock clk [get_ports {issue_ready_o}]
set_output_delay  2.276 -clock clk [get_ports {mem_req_o.address[*]}]
set_output_delay  1.207 -clock clk [get_ports {mem_req_o.outside}]
set_output_delay  1.167 -clock clk [get_ports {mem_req_o.probe}]
set_output_delay  2.254 -clock clk [get_ports {mem_req_o.size[*]}]
set_output_delay  5.479 -clock clk [get_ports {mem_req_o.valid}]
set_output_delay  0.253 -clock clk [get_ports {mem_req_o.wdata[*]}]
set_output_delay  0.211 -clock clk [get_ports {mem_req_o.write}]
set_output_delay  0.260 -clock clk [get_ports {stack_maint_o.base[*]}]
set_output_delay  0.214 -clock clk [get_ports {stack_maint_o.kind[*]}]
set_output_delay  0.212 -clock clk [get_ports {stack_maint_o.length[*]}]
set_output_delay  3.496 -clock clk [get_ports {stack_maint_o.valid}]
