# ino_system (instance u_core.u_system de TAHX_1) : budgets d'entree / sortie a 25 ns,
# coin slow, modele de fil 'Zero', tires du coeur entier par synth_InO/sta/sdc_macro.tcl.
# Par bus : le pire bit. Retards exterieurs estimes, pas une signature.
# Insertion d'horloge exterieure supposee : 0.8 ns (entrees + 0.8, sorties - 0.8).
set clk_port [get_ports clk_i]
create_clock -name clk -period 25 $clk_port
set_clock_uncertainty -setup 0.5 [get_clocks clk]
set_clock_uncertainty -hold  0.1 [get_clocks clk]
set_driving_cell -lib_cell sg13cmos5l_buf_4 -pin X [all_inputs -no_clocks]
set_load 0.02 [all_outputs]
set_input_delay   8.300 -clock clk [get_ports {boot_block_i[*]}]
set_input_delay   2.687 -clock clk [get_ports {boundary_pc_i[*]}]
set_input_delay   3.194 -clock clk [get_ports {boundary_valid_i}]
set_input_delay   1.115 -clock clk [get_ports {copile_i.cfp[*]}]
set_input_delay   1.189 -clock clk [get_ports {copile_i.csp[*]}]
set_input_delay   1.113 -clock clk [get_ports {copile_i.hp[*]}]
set_input_delay   1.081 -clock clk [get_ports {fault_i.code[*]}]
set_input_delay   1.115 -clock clk [get_ports {fault_i.valid}]
set_input_delay   1.080 -clock clk [get_ports {fault_pc_i[*]}]
set_input_delay   1.306 -clock clk [get_ports {fault_valid_i}]
set_input_delay   1.152 -clock clk [get_ports {frame_dsp_i[*]}]
set_input_delay   1.257 -clock clk [get_ports {frame_rsp_i[*]}]
set_input_delay   8.300 -clock clk [get_ports {halt_req_i}]
set_input_delay   8.300 -clock clk [get_ports {irq_pending_i[*]}]
set_input_delay   3.033 -clock clk [get_ports {issue_i.len[*]}]
set_input_delay   3.603 -clock clk [get_ports {issue_i.op[*]}]
set_input_delay   3.318 -clock clk [get_ports {issue_i.operand0[*]}]
set_input_delay   3.132 -clock clk [get_ports {issue_i.pc[*]}]
set_input_delay   3.208 -clock clk [get_ports {issue_i.val[*]}]
set_input_delay   4.332 -clock clk [get_ports {issue_valid_i}]
set_input_delay  14.346 -clock clk [get_ports {mem_ready_i}]
set_input_delay   1.951 -clock clk [get_ports {mem_rsp_i.fault}]
set_input_delay  10.802 -clock clk [get_ports {mem_rsp_i.rdata[*]}]
set_input_delay   8.888 -clock clk [get_ports {mem_rsp_i.valid}]
set_input_delay   1.083 -clock clk [get_ports {stack_maint_done_i}]
set_output_delay  4.069 -clock clk [get_ports {complete_o.fault[*]}]
set_output_delay  4.005 -clock clk [get_ports {complete_o.result[*]}]
set_output_delay  4.375 -clock clk [get_ports {complete_o.taken}]
set_output_delay  4.937 -clock clk [get_ports {complete_o.target[*]}]
set_output_delay  5.117 -clock clk [get_ports {complete_o.valid}]
set_output_delay 11.216 -clock clk [get_ports {disp_sel_o[*]}]
set_output_delay  0.607 -clock clk [get_ports {disp_wdata_o[*]}]
set_output_delay  1.835 -clock clk [get_ports {disp_we_o}]
set_output_delay  2.712 -clock clk [get_ports {disp_wsel_o[*]}]
set_output_delay  7.200 -clock clk [get_ports {exit_code_o[*]}]
set_output_delay  7.200 -clock clk [get_ports {fcode_o[*]}]
set_output_delay  7.200 -clock clk [get_ports {fpc_o[*]}]
set_output_delay  7.200 -clock clk [get_ports {halt_cause_o[*]}]
set_output_delay  7.200 -clock clk [get_ports {halted_o}]
set_output_delay  7.200 -clock clk [get_ports {irq_ack_code_o[*]}]
set_output_delay  7.200 -clock clk [get_ports {irq_ack_o}]
set_output_delay  3.650 -clock clk [get_ports {issue_ready_o}]
set_output_delay  9.075 -clock clk [get_ports {limits_o.lim_csp[*]}]
set_output_delay  5.155 -clock clk [get_ports {limits_o.lim_dsp[*]}]
set_output_delay  2.366 -clock clk [get_ports {limits_o.lim_hp[*]}]
set_output_delay  7.212 -clock clk [get_ports {limits_o.lim_rsp[*]}]
set_output_delay  2.405 -clock clk [get_ports {mem_req_o.address[*]}]
set_output_delay  1.610 -clock clk [get_ports {mem_req_o.outside}]
set_output_delay  1.511 -clock clk [get_ports {mem_req_o.probe}]
set_output_delay  2.378 -clock clk [get_ports {mem_req_o.size[*]}]
set_output_delay  5.998 -clock clk [get_ports {mem_req_o.valid}]
set_output_delay  2.992 -clock clk [get_ports {mem_req_o.wdata[*]}]
set_output_delay  0.253 -clock clk [get_ports {mem_req_o.write}]
set_output_delay  0.476 -clock clk [get_ports {redirect_pc_o[*]}]
set_output_delay  5.145 -clock clk [get_ports {redirect_valid_o}]
set_output_delay  3.583 -clock clk [get_ports {stack_maint_o.valid}]
set_output_delay  0.199 -clock clk [get_ports {sync_copile_o.cfp[*]}]
set_output_delay  0.350 -clock clk [get_ports {sync_copile_o.csp[*]}]
set_output_delay  0.274 -clock clk [get_ports {sync_copile_o.hp[*]}]
set_output_delay  1.342 -clock clk [get_ports {sync_copile_o.hp_valid}]
set_output_delay  0.264 -clock clk [get_ports {sync_dsp_o[*]}]
set_output_delay  0.272 -clock clk [get_ports {sync_rsp_o[*]}]
set_output_delay  6.868 -clock clk [get_ports {sync_valid_o}]
set_output_delay  3.195 -clock clk [get_ports {system_hold_o}]
