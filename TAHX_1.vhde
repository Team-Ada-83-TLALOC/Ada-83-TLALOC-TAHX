library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;
		------------------------------------------------------------------------------
		--
		--		T A H X _ 1	Tlaloc Ada Hardware eXecutor version 1
		--
		--	Vincent MORIN	Universite Bretagne Occidentale 2026
		------------------------------------------------------------------------------
entity TAHX_1 is
   port (

		---------------------------------
		--	C L O C K  /  R E S E T
		---------------------------------

      CLK_I          :in  std_logic;									-- Processor main clock
      RESET_I        :in  std_logic;									-- Reset line

      BOOT_ENTRY_I   :in  unsigned(63 downto 0);								-- Boot address information

		---------------------------------------------------------------------
		--	I N T E R F A C E   M E M O I R E   I N S T R U C T I O N S
		---------------------------------------------------------------------

      I_REQ_O        :out std_logic;									-- Instruction request
      I_ADDR_O       :out unsigned(63 downto 0);								-- Instruction address

      I_READY_I      :in  std_logic;									-- Instruction ready

      I_RVALID_I     :in  std_logic;									-- Instruction read valid
      I_RDATA_I      :in  unsigned(63 downto 0);								-- Instruction read data

      I_FAULT_I      :in  std_logic;									-- Instruction read fault

		--	cycle       1        2        3        4
		--	I_REQ      ────────\____________________
		--	I_ADDR_O   ===== A =====
		--	I_READY_I  ________/───\_______________
		--	                   │ 1 │
		--	I_RVALID   ________________________/───\
		--	                                   │ 1 │
		--	I_RDATA    ------------------------= instruction =


		-----------------------------------------------------------
		--	I N T E R F A C E   M E M O I R E   D O N N E E S
		-----------------------------------------------------------

      D_REQ_O        : out std_logic;									-- Data request
      D_WRITE_O      : out std_logic;									-- Data write

      D_ADDR_O       : out unsigned(63 downto 0);								-- Data address
      D_SIZE_O       : out unsigned(1 downto 0);								-- Data size (00 byte, 01 word, 10 double, 11 quad

      D_WDATA_O      : out unsigned(63 downto 0);								-- Data write output
      D_WSTRB_O      : out std_logic_vector(7 downto 0);							-- Data write byte strobe

      D_READY_I      : in  std_logic;									-- Data ready

      D_RVALID_I     : in  std_logic;									-- Data read valid
      D_RDATA_I      : in  unsigned(63 downto 0);								-- Data read input

      D_FAULT_I      : in  std_logic;									-- Data fault


		-----------------------------------
		--	I N T E R R U P T I O N S
		-----------------------------------

      IRQ_I          : in  std_logic;									-- Interrupt request input
      IRQ_CODE_I     : in  unsigned(7 downto 0);								-- Interrupt code input
      IRQ_ACK_O      : out std_logic;									-- Interrupt aquittement


		-------------------
		--	D E B U G
		-------------------

      HALT_REQ_I     : in  std_logic;									-- Processor halt request
      HALTED_O       : out std_logic									-- Processor halted output flag

   );

end entity TAHX_1;
