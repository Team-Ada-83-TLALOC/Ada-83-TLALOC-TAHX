use work.TAHX_DECODE_TYPES.all;
use work.TAHX_RENAME_TYPES.all;

		--------------------------------------------------------------------------------
		--		DECODE_QUEUE
		--		     │
		--		     │ decoded_block_t
		--		     v
		--		┌────────────────────────┐
		--		│   RENAME_DISPATCH      │
		--		│                        │
		--		│ SPEC_DSP               │
		--		│ EVAL_STACK_MAP         │
		--		│ LOCAL_MAP[64]          │
		--		│ FRAME_STATE            │
		--		│ FREE_LIST              │
		--		│ CHECKPOINTS            │
		--		│ RENAME_HISTORY         │
		--		└────────────┬───────────┘
		--		             │
		--		             │ renamed_block_t
		--		             v
		--		          BACKEND
		--------------------------------------------------------------------------------

				---------------
entity				RENAME_DISPATCH
is				---------------
   port (

      ----------------------------------------------------------------
      -- Horloge / reset
      ----------------------------------------------------------------

      CLK_I		:in std_logic;
      RESET_I		:in std_logic;


      ----------------------------------------------------------------
      -- Initialisation de l'état architectural
      --
      -- DSP est nécessaire car les cellules de pile sont suivies
      -- par leur position logique.
      ----------------------------------------------------------------

      INIT_I		: in std_logic;

      INIT_DSP_I		: in address_t;
      INIT_LEVEL_I		: in level_t;

      ----------------------------------------------------------------
      -- Entrée venant de DECODE_QUEUE
      --
      -- Les instructions valides sont :
      --
      --   DECODE_BLOCK_I(0 .. DECODE_COUNT_I-1)
      ----------------------------------------------------------------

      DECODE_VALID_I	:in std_logic;
      DECODE_BLOCK_I	:in decoded_block_t;
      DECODE_COUNT_I	:in unsigned( 3 downto 0 );
      DECODE_READY_O	:out std_logic;

      ----------------------------------------------------------------
      -- Sortie vers le backend
      --
      -- Une instruction décodée produit toujours une entrée renommée,
      -- même lorsqu'aucune unité fonctionnelle n'est nécessaire.
      --
      -- Donc normalement :
      --
      --   RENAME_COUNT_O = DECODE_COUNT_I
      ----------------------------------------------------------------

      RENAME_VALID_O	:out std_logic;
      RENAME_BLOCK_O	:out renamed_block_t;
      RENAME_COUNT_O	:out unsigned(3 downto 0);
      RENAME_READY_I	:in std_logic;

      ----------------------------------------------------------------
      -- Retirement
      --
      -- Nombre d'instructions les plus anciennes définitivement
      -- validées par le ROB durant ce cycle.
      --
      -- RENAME_DISPATCH maintient en interne l'historique nécessaire
      -- pour avancer son état "committed".
      ----------------------------------------------------------------

      RETIRE_COUNT_I	:in unsigned(3 downto 0);

      ----------------------------------------------------------------
      -- Récupération après mauvaise prédiction ou exception
      ----------------------------------------------------------------

      RECOVER_VALID_I	: in std_logic;
      RECOVER_KIND_I	:in recovery_kind_t;
      RECOVER_CHECKPOINT_I	:in checkpoint_id_t;


      ----------------------------------------------------------------
      -- État / diagnostic
      ----------------------------------------------------------------

      STALLED_O		:out std_logic;
      FREE_PHYSICAL_COUNT_O	:out unsigned( PHYSICAL_TAG_BITS downto 0 )

   );

end entity	RENAME_DISPATCH;
		---------------

------------------------------------------------------------------------------------------------------------------------
