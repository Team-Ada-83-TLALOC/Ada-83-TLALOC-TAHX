set_input_delay -max  12.560 -clock clk [get_ports {recovery_i.ghist[9]}]
set_input_delay -max  12.713 -clock clk [get_ports {recovery_i.ras_ptr[*]}]   ;# avant 2.602
set_input_delay -min 2.602 -clock clk [get_ports {recovery_i.ras_ptr[*]}]
set_input_delay -max  11.539 -clock clk [get_ports {recovery_i.ras_ptr[0]}]
set_input_delay -max  12.307 -clock clk [get_ports {recovery_i.ras_ptr[1]}]
set_input_delay -max  10.404 -clock clk [get_ports {recovery_i.valid}]   ;# avant 2.909
set_input_delay -min 2.909 -clock clk [get_ports {recovery_i.valid}]
set_input_delay -max   7.082 -clock clk [get_ports {retire_i.conditional}]   ;# avant 1.914
set_input_delay -min 1.914 -clock clk [get_ports {retire_i.conditional}]
set_input_delay -max   8.825 -clock clk [get_ports {retire_i.ghist_low[*]}]   ;# avant 1.949
