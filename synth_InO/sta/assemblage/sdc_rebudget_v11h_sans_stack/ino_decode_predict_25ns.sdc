# Rebudgete (rebudgeter.py, chemins_v11h.txt) : periode 26.0 ns, atteignable 27.17 ; g = 0.800 pour cette macro.
# -max : instants alloues par la STA d'assemblage (meme instant pour la sortie d'une
# macro et l'entree qu'elle attaque), biais 0.3 ns ; -min : ancien SDC (hold).
# Repere : broche d'horloge de la macro ; l'insertion interne (0.80 ns) est vue
# par le flux en horloge propagee. Valeur d'un bus : son pire bit, puis les bits qui s'en
# ecartent. Traversees : set_max_delay par paire de bus. Ne pas modifier a la main.
set clk_port [get_ports clk_i]
create_clock -name clk -period 27.1675 $clk_port
set_clock_uncertainty -setup 0.5 [get_clocks clk]
set_clock_uncertainty -hold  0.1 [get_clocks clk]
set_driving_cell -lib_cell sg13cmos5l_buf_4 -pin X [all_inputs -no_clocks]
set_load 0.02 [all_outputs]
set_input_delay -max   5.613 -clock clk [get_ports {out_ready_i}]   ;# avant 1.700
set_input_delay -min 1.700 -clock clk [get_ports {out_ready_i}]
set_input_delay -max  13.621 -clock clk [get_ports {recovery_i.ghist[*]}]   ;# avant 2.603
set_input_delay -min 2.603 -clock clk [get_ports {recovery_i.ghist[*]}]
set_input_delay -max  12.783 -clock clk [get_ports {recovery_i.ghist[10]}]
set_input_delay -max  13.077 -clock clk [get_ports {recovery_i.ghist[11]}]
